# Git
.git/
.gitignore

# Backups
backups/
backup-*.tar.gz
*.tar.gz

# Environment (will be provided at runtime)
.env

# Runtime directories (will be mounted as volumes)
data/
logs/
tmp/

# Documentation (not needed in image)
README.md
QUICKSTART.md
LICENSE

# Scripts (not needed in image)
start.sh
stop.sh
update.sh
backup.sh

# OS
.DS_Store
Thumbs.db

# Frontend local dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Python/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
coverage/
backend/tests/
backend/requirements-dev.txt
